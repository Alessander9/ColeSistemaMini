# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sesión firmada (obligatoria en producción, mínimo 32 caracteres aleatorios)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Inicio de sesión de demostración sin Supabase (cuentas de ejemplo guardadas en el navegador).
# En producción queda desactivado salvo que pongas "true" aquí. No lo actives para un colegio real.
ALLOW_DEMO_LOGIN=false

# Application Settings
NEXT_PUBLIC_APP_NAME="ColeSistema Mini"
NEXT_PUBLIC_SCHOOL_NAME="Colegio San Martín de Porres"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary CDN & Avatar Storage Configuration (Gratis 25GB)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=colegio_preset
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend Email Service Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

